{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "package.json",
      "package-lock.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.test.js",
      "**/*.ignore.*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
